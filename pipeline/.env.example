# Gemini API Key for automated image generation (legacy)
# Get yours at: https://aistudio.google.com -> Get API Key
GEMINI_API_KEY=your-api-key-here

# Optional: Override default model (gemini-2.5-flash-image)
# GEMINI_MODEL=gemini-3-pro-image-preview

# Kling AI credentials for manga panel generation (primary)
# Get yours at: https://app.klingai.com/global/dev/document-api
KLING_ACCESS_KEY=your-access-key-here
KLING_SECRET_KEY=your-secret-key-here
